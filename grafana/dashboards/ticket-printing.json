{
  "title": "Ticket Printing Platform",
  "uid": "ticket-printing-overview",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Toner level",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "printing_toner_level",
          "legendFormat": "toner",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Paper level",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 250,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "printing_paper_level",
          "legendFormat": "paper",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tickets printed (rate by type)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(printing_tickets_printed_total[1m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Resource-low events (by resource & outcome)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (resource, outcome) (rate(printing_resource_low_events_total[5m]))",
          "legendFormat": "{{resource}} - {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Resupply refills (by resource & outcome)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (resource, outcome) (rate(resupply_refills_total[5m]))",
          "legendFormat": "{{resource}} - {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Resource-unavailable rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(printing_resource_unavailable_total[1m])",
          "legendFormat": "409 Conflict",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Passenger requests (rate by outcome)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(passenger_tickets_requested_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
